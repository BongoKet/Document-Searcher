{
  "name": "document-searcher",
  "version": "5.0.0",
  "author": "David",
  "description": "Professional Excel, Word and PDF Search Utility",
  "main": "main/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.david.excelsearch",
    "productName": "Document Searcher",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Document Searcher"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "resources/search.exe",
        "to": "python/search.exe"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "BongoKet",
      "repo": "Document-Searcher"
    }
  }
}
